generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SupportingStaff {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  role        String   // hod | stage_leader | dean_of_studies | director_tl | deputy_principal | hr | curriculum_leader | middle_leader | academic_admin | principal
  subSchool   String?  // junior | senior | both
  department  String?
  portalToken String   @unique @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hodFor           Staff[] @relation("AssignedHod")
  stageFor         Staff[] @relation("AssignedStageLeader")
  deanFor          Staff[] @relation("AssignedDean")
  directorFor      Staff[] @relation("AssignedDirector")
  deputyFor        Staff[] @relation("AssignedDeputy")
  academicAdminFor Staff[] @relation("AssignedAcademicAdmin")
  principalFor     Staff[] @relation("AssignedPrincipal")
  surveysSent      Survey[]
}

model TermCalendar {
  id        String   @id @default(cuid())
  year      Int
  term      Int
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, term])
}

model Staff {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  subSchool    String
  department   String?
  teachingRole String?
  startDate    DateTime
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?
  teacherToken String?          @unique
  probation    Probation?

  // Step access grants per role slot: JSON {"hod":[1,2,3],"dean":null,...} null=all steps
  stepAccessGrants String?

  hodId           String?
  hod             SupportingStaff? @relation("AssignedHod",           fields: [hodId],           references: [id])
  stageLeaderId   String?
  stageLeader     SupportingStaff? @relation("AssignedStageLeader",   fields: [stageLeaderId],   references: [id])
  deanId          String?
  dean            SupportingStaff? @relation("AssignedDean",          fields: [deanId],          references: [id])
  directorId      String?
  director        SupportingStaff? @relation("AssignedDirector",      fields: [directorId],      references: [id])
  deputyId        String?
  deputy          SupportingStaff? @relation("AssignedDeputy",        fields: [deputyId],        references: [id])
  academicAdminId String?
  academicAdmin   SupportingStaff? @relation("AssignedAcademicAdmin", fields: [academicAdminId], references: [id])
  principalId     String?
  principal       SupportingStaff? @relation("AssignedPrincipal",     fields: [principalId],     references: [id])
}

model Probation {
  id                String          @id @default(cuid())
  staffId           String          @unique
  staff             Staff           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  status            String          @default("active")
  currentStep       Int             @default(1)
  extensionReason   String?
  extendedAt        DateTime?
  extendedBy        String?
  extensionFromStep Int?
  steps             ProbationStep[]
  concerns          EarlyConcern[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model ProbationStep {
  id             String    @id @default(cuid())
  probationId    String
  probation      Probation @relation(fields: [probationId], references: [id], onDelete: Cascade)
  stepNumber     Int
  customLabel    String?   // "a", "b" for added steps; displayed as "3a", "3b"
  isCustom       Boolean   @default(false)
  sortOrder      Float     @default(0)  // ordering: 1.0, 2.0, 3.0, 3.1=3a, 4.0...
  customTitle    String?   // title for custom steps
  status         String    @default("pending")
  outcome        String?
  completedAt    DateTime?
  completedBy    String?
  notes          String?
  supportActions String?
  formData       String?
  attachments           StepAttachment[]
  survey                Survey?
  teacherAcknowledgedAt DateTime?
  teacherReflection     String?
  acknowledgedAt        DateTime?
  acknowledgedBy        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([probationId, sortOrder])
}

model StepAttachment {
  id           String        @id @default(cuid())
  stepId       String
  step         ProbationStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  mimeType     String
  size         Int
  uploadedBy   String
  uploadedAt   DateTime      @default(now())
}

model Survey {
  id              String           @id @default(cuid())
  stepId          String           @unique
  step            ProbationStep    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  sentById        String?
  sentBy          SupportingStaff? @relation(fields: [sentById], references: [id])
  recipientEmails String
  sentAt          DateTime?
  closedAt        DateTime?
  responses       SurveyResponse[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model SurveyResponse {
  id              String   @id @default(cuid())
  surveyId        String
  survey          Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  respondentName  String
  respondentEmail String
  overallRating   String
  strengths       String?
  concerns        String?
  additionalNotes String?
  submittedAt     DateTime @default(now())
}

model EarlyConcern {
  id              String    @id @default(cuid())
  probationId     String
  probation       Probation @relation(fields: [probationId], references: [id], onDelete: Cascade)
  triggeredAt     DateTime  @default(now())
  triggeredBy     String
  triggerStep     Int
  triggers        String
  status          String    @default("active")
  actionsTaken    String?
  supportMeasures String?
  resolution      String?
  resolvedAt      DateTime?
  updatedAt       DateTime  @updatedAt
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  type      String
  relatedId String?
  sentAt    DateTime @default(now())
  status    String   @default("sent")
  error     String?
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  staffId     String?
  performedBy String
  details     String?
  createdAt   DateTime @default(now())

  @@index([staffId])
}
